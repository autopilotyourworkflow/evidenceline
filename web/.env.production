# Build settings for the published site (https://evidenceline.autopilotyourworkflow.com). Vite reads this file for
# `npm run build` (mode "production", everything on) and `npm run build:launch` (the same, with the question box,
# the connector and the robot check switched off). `npm run dev` and `npm run build:offline` do not read it.
# A variable set in the build environment overrides the value here. Only public VITE_ settings belong in this file.

# Public code repository, for the "Code on GitHub" button.
VITE_GITHUB_URL=https://github.com/autopilotyourworkflow/evidenceline

# The read-only MCP connector. The site's Cloudflare Worker forwards /mcp to the API service on Render.
VITE_MCP_URL=https://evidenceline.autopilotyourworkflow.com/mcp

# "/" means the site's own origin: the question box posts to /api/ask, which the Worker forwards to Render.
# (An empty value switches the live box off, as in .env.example.)
VITE_API_BASE=/

# Cloudflare Turnstile site key (public), from the widget created for evidenceline.autopilotyourworkflow.com.
# Empty: no robot check. Set it before TURNSTILE_SECRET is set on the API, never after (DEPLOY.md).
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFBiJ_ptg7cGf8_Z
