# Build-time settings for the website. Copy to .env.local (git-ignored) or set them in the build environment.
# An empty value switches the feature off: the site then hides the link, or says it is coming soon, instead of
# showing a dead one. The published site's values are in .env.production, which Vite reads for `npm run build` only;
# `npm run dev` and `npm run build:offline` use this file's empty defaults, and `npm run build:launch` uses
# .env.production with the question box, the connector and the robot check switched off.

# Public code repository, for the "Code on GitHub" button. Empty: the button is not shown.
VITE_GITHUB_URL=

# Read-only remote MCP connector, for "Use it inside your own Claude". Empty: the card says the connector link will
# appear here soon.
VITE_MCP_URL=

# Base URL of the live question service (no trailing slash). The question box posts to {VITE_API_BASE}/api/ask.
# "/" means the site's own origin (posts to /api/ask). Empty: the box says live answers are switching on soon and
# offers the prepared questions.
VITE_API_BASE=

# Cloudflare Turnstile site key (public). Set: the question box shows the "not a robot" check and sends its token as
# turnstile_token with each live question. Empty: no check. Used only when VITE_API_BASE is set. For local tests use
# Cloudflare's always-pass test key 1x00000000000000000000AA.
VITE_TURNSTILE_SITE_KEY=
